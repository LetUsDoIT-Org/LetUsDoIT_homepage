# Contact form delivery. Create a key at https://resend.com/api-keys
# and set the same value in the Vercel project under Settings → Environment
# Variables, for Production, Preview and Development.
RESEND_API_KEY=

# Optional. Defaults to onboarding@resend.dev, which only delivers to the
# Resend account owner. Once letusdoit.dk is verified as a sending domain in
# Resend, set this to something on that domain, e.g. hjemmeside@letusdoit.dk
CONTACT_FROM_ADDRESS=
